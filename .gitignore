# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local pnpm content-addressable store (should not be in repo)
.pnpm-store/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Per-project full ZK compile output (legacy path; prefer .data/)
/public/contracts/managed/

# Private managed ZK artifacts (public product)
/.data/

