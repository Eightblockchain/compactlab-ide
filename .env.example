# CompactLab — shared public product / local lab

# Required for public/production API routes (long random string)
COMPACTLAB_SESSION_SECRET="replace-with-a-long-random-secret"

# Public product mode (stricter defaults). Auto-on when NODE_ENV=production.
# COMPACTLAB_PUBLIC="true"

# Allow server-side Compact CLI compile on this host (off by default in public mode).
# Only enable on a hardened worker with Compact CLI installed + disk/CPU quotas.
# COMPACTLAB_ENABLE_COMPILE="true"

# Optional overrides
# COMPACTLAB_DATA_DIR="/var/lib/compactlab/managed"
# COMPACTLAB_RATE_LIMIT_PER_MIN="30"
# COMPACTLAB_ZK_COMPILE_PER_HOUR="3"
# COMPACTLAB_SKIP_ZK_PER_HOUR="60"
# COMPACTLAB_INDEXER_PER_MIN="40"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_NETWORK="preprod"
